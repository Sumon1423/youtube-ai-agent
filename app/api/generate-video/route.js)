    const body = await request.json();
    const { title, script, audioUrl } = body;

    // এখানে আপনার স্ক্রিপ্ট, টাইটেল এবং অডিও ফাইল রিসিভ হয়ে ব্যাকএন্ড প্রসেসিং শুরু হবে
    console.log("Processing Video for:", title);

    // সফলভাবে রেন্ডারিং শুরু হওয়ার রেসপন্স (ডেমো লিংক বা ভিডিও রেন্ডার হওয়ার পর রিয়েল লিংক)
    return NextResponse.json({
      success: true,
